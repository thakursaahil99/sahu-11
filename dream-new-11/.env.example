# ─── Dream New 11 — environment ─────────────────────────────────────────────
# Copy to .env (repo root). Every variable is documented in docs/ENV.md.

# Runtime
NODE_ENV=development
PORT=4000
# demo = seeded data, fixed OTP 123456, practice/free only. production = real providers.
APP_MODE=demo
# Paid contests stay off unless this is true AND APP_MODE=production AND compliance is in place.
ENABLE_PAID_CONTESTS=false

# Database (local: `npm run db:start`, no Docker needed)
DATABASE_URL=postgresql://dream11:dream11@localhost:5433/dream11?schema=public

# Auth secrets — generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
SIGNUP_TOKEN_SECRET=change-me-signup-secret-at-least-32-characters-long
OTP_SECRET=change-me-otp-secret-at-least-32-characters-long-xx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# HTTP
# Comma-separated browser origins (admin panel). Native apps need no entry.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
TRUST_PROXY=false
UPLOAD_DIR=uploads

# SMS OTP: console | twilio | msg91
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Email: console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dream New 11 <no-reply@dreamnew11.app>"

# Real money (all must be set, plus APP_MODE=production and ENABLE_PAID_CONTESTS=true).
# REAL_MONEY_COMPLIANCE_ACK=true only after legal review: KYC, TDS, geo-blocking, responsible play.
REAL_MONEY_COMPLIANCE_ACK=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Real-money compliance (only used when paid play is enabled)
# States where paid play is blocked; empty = the built-in default list (AP,TG,AS,OR,SK,NL). Set from legal advice.
RESTRICTED_STATES=
# CDN/proxy header with the visitor country, e.g. cf-ipcountry (paid play is refused outside India)
GEO_COUNTRY_HEADER=
# TDS on net winnings at withdrawal (Income-tax Act s.194BA)
TDS_RATE_PERCENT=30

# Demo credits given once to each new demo wallet
DEMO_WELCOME_BONUS=1000

# Sports data: mock (demo only) | cricketdata
SPORTS_PROVIDER=mock
CRICKETDATA_API_KEY=
SPORTS_SYNC_ENABLED=true
# Seconds between fixture syncs. Keep >= 1800 on the CricketData free plan.
SPORTS_SYNC_INTERVAL_SECONDS=60

# Live scoring: poll interval for live matches (seconds)
LIVE_SCORING_ENABLED=true
LIVE_POLL_SECONDS=10

# Auto-create practice/free contests for upcoming matches (empty = on in demo, off in production)
CONTEST_TEMPLATES_ENABLED=

# App download: the /download page button links here (EAS APK link or Play Store). Empty = coming soon.
APP_DOWNLOAD_URL=
# Public base URL of the API (for shareable links)
PUBLIC_API_URL=

# ─── Push notifications ───
# log = print to the API console (dev/demo) · expo = Expo push service (FCM/APNs) · fcm = Firebase HTTP v1
PUSH_PROVIDER=log
# Optional, for Expo's enhanced push security
EXPO_ACCESS_TOKEN=
# Firebase service-account JSON (raw or base64), required for PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_JSON=
# Minutes before the deadline to remind users who have a team
MATCH_REMINDER_MINUTES=30

# Admin panel: staff must use TOTP 2FA. Empty = on in production, off in demo.
ADMIN_MFA_REQUIRED=

# Public links
SUPPORT_EMAIL=support@dreamnew11.app
TERMS_URL=https://dreamnew11.app/terms
PRIVACY_URL=https://dreamnew11.app/privacy

# Mobile (Expo reads EXPO_PUBLIC_* at build time). Leave empty to auto-detect your dev machine's LAN IP.
EXPO_PUBLIC_API_URL=
